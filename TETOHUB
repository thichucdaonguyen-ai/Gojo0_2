task.spawn(function()
    local timeCount = 0
    while true do
        timeCount = timeCount + task.wait(0.03)
        local scaleFactor = 1 + math.sin(timeCount * 2.5) * 0.04
        ToggleButton.Size = UDim2.new(0, 50 * scaleFactor, 0, 50 * scaleFactor)

        if Frame.Visible then
            Frame.Rotation = math.sin(timeCount * 1.5) * 1.2
        end
    end
end)

