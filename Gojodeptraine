-- MAIN TAB (LOCK = 4.0 STUD | M1 TARGET = 3.75 STUD)
local TabMain = CreateTab("Main")
local MainDropdown = TabMain:CreateDropdown("Select Target", GetPlayerList(), function(v) TargetPlayerName = v end)
TabMain:CreateButton("Refresh Player List", function() MainDropdown.Refresh(GetPlayerList()) end)

TabMain:CreateToggle("Lock Behind Target", function(v)
    BehindTargetEnabled = v
    StopLock()
    if BehindTargetEnabled then
        local target = GetPlayerFromSelected(TargetPlayerName)
        if not target then return end
        ToggleSkillButtons(false)
        local function LockPosition()
            if not BehindTargetEnabled then return end
            local lChar, tChar = LocalPlayer.Character, target.Character
            if lChar and tChar and lChar:FindFirstChild("HumanoidRootPart") and tChar:FindFirstChild("HumanoidRootPart") then
                for _, p in pairs(lChar:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = false end end
                -- Khoảng cách 4.0 Stud
                lChar:PivotTo(tChar.HumanoidRootPart.CFrame * CFrame.new(0, 0, 4.0))
            end
        end
        TargetConnectionRender = RunService.RenderStepped:Connect(LockPosition)
    end
end)

TabMain:CreateToggle("Orbit Target", function(v)
    OrbitTargetEnabled = v
    StopLock()
    if OrbitTargetEnabled then
        local target = GetPlayerFromSelected(TargetPlayerName)
        if not target then return end
        ToggleSkillButtons(false)
        OrbitLoopTask = task.spawn(function()
            while OrbitTargetEnabled do
                local lChar, tChar = LocalPlayer.Character, target.Character
                if lChar and tChar and lChar:FindFirstChild("HumanoidRootPart") and tChar:FindFirstChild("HumanoidRootPart") then
                    for _, p in pairs(lChar:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = false end end
                    local angle = tick() * 12
                    local newPos = tChar.HumanoidRootPart.Position + Vector3.new(math.cos(angle)*3, 0.5, math.sin(angle)*3)
                    lChar:PivotTo(CFrame.new(newPos, tChar.HumanoidRootPart.Position))
                end
                RunService.Heartbeat:Wait()
            end
        end)
    end
end)

TabMain:CreateToggle("M1 Auto Target Near", function(v)
    M1TargetEnabled = v
    StopLock()
    if M1ClickConnection then M1ClickConnection:Disconnect() M1ClickConnection = nil end
    if M1TargetEnabled then
        M1ClickConnection = UserInputService.InputBegan:Connect(function(input, gp)
            if gp or M1ActiveLock then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local lChar = LocalPlayer.Character
                if not lChar or not lChar:FindFirstChild("HumanoidRootPart") then return end
                local closest, minDist = nil, 60
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChildOfClass("Humanoid") then
                        if plr.Character.Humanoid.Health > 0 then
                            local dist = (plr.Character.HumanoidRootPart.Position - lChar.HumanoidRootPart.Position).Magnitude
                            if dist <= minDist then minDist, closest = dist, plr end
                        end
                    end
                end
                if closest then
                    M1ActiveLock = true
                    ToggleSkillButtons(false)
                    M1LockTask = task.spawn(function()
                        while M1ActiveLock and M1TargetEnabled do
                            local tChar, mChar = closest.Character, LocalPlayer.Character
                            if not tChar or not tChar:FindFirstChild("Humanoid") or tChar.Humanoid.Health <= 0 or not mChar then StopLock(); break end
                            for _, p in pairs(mChar:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = false end end
                            -- Khoảng cách 3.75 Stud
                            mChar:PivotTo(tChar.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3.75))
                            RunService.Heartbeat:Wait()
                        end
                    end)
                end
            end
        end)
    end
end)

