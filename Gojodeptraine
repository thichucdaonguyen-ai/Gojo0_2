local TabESP = CreateTab("ESP")
local function CreateESP(plr)
    if plr == LocalPlayer then return end
    local function ApplyESP(char)
        if not char then return end
        if char:FindFirstChild("khanhlyESP") then char.khanhlyESP:Destroy() end
        local Highlight = Instance.new("Highlight", char)
        Highlight.Name = "khanhlyESP"
        Highlight.FillColor = ESP_Color
        Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        Highlight.FillTransparency = 0.4
        Highlight.OutlineTransparency = 0
        Highlight.Enabled = ESP_Enabled

        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if hrp then
            if hrp:FindFirstChild("khanhlyESP_Info") then hrp.khanhlyESP_Info:Destroy() end
            local Billboard = Instance.new("BillboardGui", hrp)
            Billboard.Name = "khanhlyESP_Info"
            Billboard.Size = UDim2.new(0, 200, 0, 40)
            Billboard.AlwaysOnTop = true
            Billboard.ExtentsOffset = Vector3.new(0, 3, 0)
            Billboard.Enabled = ESP_Enabled
            local TextLabel = Instance.new("TextLabel", Billboard)
            TextLabel.Size = UDim2.new(1, 0, 1, 0)
            TextLabel.BackgroundTransparency = 1
            TextLabel.TextColor3 = ESP_Color
            TextLabel.Font = Enum.Font.SourceSansBold
            TextLabel.TextSize = 14
            TextLabel.TextStrokeTransparency = 0
            TextLabel.Text = plr.DisplayName
        end
    end
    if plr.Character then ApplyESP(plr.Character) end
    plr.CharacterAdded:Connect(ApplyESP)
end

RunService.RenderStepped:Connect(function()
    if ESP_Line_Enabled then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local vector, onScreen = Camera:WorldToViewportPoint(plr.Character.HumanoidRootPart.Position)
                if onScreen then
                    if not TracerLines[plr] then
                        local line = Drawing.new("Line")
                        line.Thickness = 1.8; line.Transparency = 1; TracerLines[plr] = line
                    end
                    TracerLines[plr].Color = ESP_Color
                    TracerLines[plr].From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    TracerLines[plr].To = Vector2.new(vector.X, vector.Y)
                    TracerLines[plr].Visible = true
                else
                    if TracerLines[plr] then TracerLines[plr].Visible = false end
                end
            else
                if TracerLines[plr] then TracerLines[plr].Visible = false end
            end
        end
    else
        for _, line in pairs(TracerLines) do line.Visible = false end
