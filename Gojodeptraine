local CombatService
task.spawn(function()
    pcall(function()
        local Knit = ReplicatedStorage:WaitForChild("Knit", 5)
        if Knit then
            local Services = Knit:WaitForChild("Services", 5)
            if Services then CombatService = Services:WaitForChild("CombatService", 5) end
        end
    end)
end)

local function FireGodDamage(targetChar)
    if not targetChar then return end
    local head = targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("HumanoidRootPart")
    if LocalPlayer.Character then
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
    end
    if CombatService then
        local reFolder = CombatService:FindFirstChild("RE")
        if reFolder then
            for _, v in ipairs(reFolder:GetChildren()) do
                if v:IsA("RemoteEvent") then
                    pcall(function()
                        v:FireServer(targetChar)
                        if head then
                            v:FireServer(targetChar, head)
                            v:FireServer(head.Position)
                        end
                    end)
                end
            end
        end
    end
end

-- SỬA LỖI DROPDOWN PLAYER LIST: LẤY ĐẦY ĐỦ TÊN NGUYÊN BẢN & DISPLAY NAME
local function GetPlayerList()
    local list = {}
    for _, plr in pairs(Players:GetPlayers()) do 
        if plr ~= LocalPlayer then 
            table.insert(list, plr.Name .. " (" .. plr.DisplayName .. ")") 
        end 
    end
    if #list == 0 then table.insert(list, "No Players Found") end
    return list
end

local function GetPlayerFromSelected(selectedString)
    if not selectedString or selectedString == "" or selectedString == "No Players Found" then return nil end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local formattedName = plr.Name .. " (" .. plr.DisplayName .. ")"
            if selectedString == formattedName or selectedString == plr.Name or selectedString == plr.DisplayName then 
                return plr 
            end
        end
    end
    return nil
end

local function ToggleSkillButtons(visible)
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        for _, gui in pairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                for _, btn in pairs(gui:GetDescendants()) do
                    if (btn:IsA("TextButton") or btn:IsA("ImageButton")) and not btn:IsA("TextLabel") then
                        local btnName = string.lower(btn.Name)
                        if string.find(btnName, "skill") or string.find(btnName, "ability") or string.find(btnName, "action") then
                            btn.Visible = visible
                        end
                    end
                end
            end
        end
    end
end

local function StopLock()
    if TargetConnectionRender then TargetConnectionRender:Disconnect() TargetConnectionRender = nil end
    if TargetConnectionStep then TargetConnectionStep:Disconnect() TargetConnectionStep = nil end
    if OrbitLoopTask then task.cancel(OrbitLoopTask) OrbitLoopTask = nil end
    if M1LockTask then task.cancel(M1LockTask) M1LockTask = nil end
    M1ActiveLock = false
    local localChar = LocalPlayer.Character
    if localChar then
        local humanoid = localChar:FindFirstChildOfClass("Humanoid")
        local hrp = localChar:FindFirstChild("HumanoidRootPart")
        if humanoid then humanoid.PlatformStand = false; pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
        if hrp then hrp.Anchored = false end
    end
    ToggleSkillButtons(true)
end

