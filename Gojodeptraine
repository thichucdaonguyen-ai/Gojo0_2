        Label.Position = UDim2.new(0, 15, 0, 0)
        Label.BackgroundTransparency = 1
        Label.Text = title
        Label.Font = Enum.Font.Gotham
        Label.TextSize = 12
        Label.TextColor3 = Theme.Text
        Label.TextXAlignment = Enum.TextXAlignment.Left

        local ToggleBtn = Instance.new("TextButton", ToggleFrame)
        ToggleBtn.Size = UDim2.new(0, 34, 0, 18)
        ToggleBtn.Position = UDim2.new(1, -42, 0.5, -9)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 40, 60)
        ToggleBtn.Text = ""
        Instance.new("UICorner", ToggleBtn).CornerRadius = Theme.ElementCorner

        local Circle = Instance.new("Frame", ToggleBtn)
        Circle.Size = UDim2.new(0, 14, 0, 14)
        Circle.Position = UDim2.new(0, 2, 0.5, -7)
        Circle.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
        Instance.new("UICorner", Circle).CornerRadius = Theme.ElementCorner

        local state = false
        ToggleBtn.MouseButton1Click:Connect(function()
            state = not state
            TweenService:Create(Circle, TweenInfo.new(0.2), {Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}):Play()
            TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(50, 40, 60)}):Play()
            callback(state)
        end)
    end

    function Elements:CreateButton(title, callback)
        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(1, 0, 0, 36)
        Btn.BackgroundColor3 = Theme.Container
        Btn.Text = title
        Btn.Font = Enum.Font.GothamBold
        Btn.TextSize = 12
        Btn.TextColor3 = Theme.Text
        Btn.Parent = TabPage
        Instance.new("UICorner", Btn).CornerRadius = Theme.ElementCorner

        Btn.MouseButton1Click:Connect(function()
            TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Accent}):Play()
            task.wait(0.1)
            TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Container}):Play()
            callback()
        end)
    end

    function Elements:CreateDropdown(title, items, callback)
        local DropFrame = Instance.new("Frame")
        DropFrame.Size = UDim2.new(1, 0, 0, 36)
        DropFrame.BackgroundColor3 = Theme.Container
        DropFrame.Parent = TabPage
        DropFrame.ClipsDescendants = true
        Instance.new("UICorner", DropFrame).CornerRadius = Theme.ElementCorner

        local DropBtn = Instance.new("TextButton", DropFrame)
        DropBtn.Size = UDim2.new(1, 0, 0, 36)
        DropBtn.BackgroundTransparency = 1
        DropBtn.Text = "  " .. title .. " : [None]"
        DropBtn.Font = Enum.Font.Gotham
        DropBtn.TextSize = 11
        DropBtn.TextColor3 = Theme.Text
        DropBtn.TextXAlignment = Enum.TextXAlignment.Left

        local Scroll = Instance.new("ScrollingFrame", DropFrame)
        Scroll.Size = UDim2.new(1, -16, 0, 120)
        Scroll.Position = UDim2.new(0, 8, 0, 36)
        Scroll.BackgroundTransparency = 1
        Scroll.ScrollBarThickness = 3
        
        local SLayout = Instance.new("UIListLayout", Scroll)
        SLayout.Padding = UDim.new(0, 4)

        SLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Scroll.CanvasSize = UDim2.new(0, 0, 0, SLayout.AbsoluteContentSize.Y)
        end)

        local open = false
        DropBtn.MouseButton1Click:Connect(function()
            open = not open
            TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = open and UDim2.new(1, 0, 0, 160) or UDim2.new(1, 0, 0, 36)}):Play()
        end)

        local function refresh(newItems)
            for _, v in pairs(Scroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
            for _, item in pairs(newItems) do
                local ItemBtn = Instance.new("TextButton", Scroll)
                ItemBtn.Size = UDim2.new(1, -5, 0, 24)
                ItemBtn.BackgroundColor3 = Color3.fromRGB(40, 30, 55)
                ItemBtn.Text = item
                ItemBtn.Font = Enum.Font.Gotham
                ItemBtn.TextSize = 10
                ItemBtn.TextColor3 = Theme.Text
                ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
                Instance.new("UICorner", ItemBtn).CornerRadius = Theme.ElementCorner
                
                ItemBtn.MouseButton1Click:Connect(function()
                    DropBtn.Text = "  " .. title .. " : " .. item
                    open = false
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 36)}):Play()
                    callback(item)
                end)
            end
        end
        refresh(items)
        return { Refresh = refresh }
    end

    return Elements
end

